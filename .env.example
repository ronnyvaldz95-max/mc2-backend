PORT=3000

# --- Opción A: Postgres local de Docker (docker-compose.yml del prototipo) ---
PGHOST=localhost
PGPORT=5432
PGUSER=mc2
PGPASSWORD=mc2dev
PGDATABASE=mc2_movilidad
PGSSL=false

# --- Opción B: Supabase (u otro Postgres remoto) ---
# Si seteás DATABASE_URL, se usa esa y se ignoran las variables PG* de arriba.
# La sacás de Supabase: Project Settings -> Database -> Connection string (URI).
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
# PGSSL=true

REDIS_HOST=localhost
REDIS_PORT=6379
