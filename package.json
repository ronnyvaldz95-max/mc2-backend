{
  "name": "mc2-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS de MC2 Movilidad - matching pasajero-conductor + auth",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "simulate:driver": "node scripts/simulate-driver.js",
    "simulate:passenger": "node scripts/simulate-passenger.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pg": "^8.11.5",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.4.1",
    "@nestjs/websockets": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "socket.io": "^4.7.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "socket.io-client": "^4.7.5"
  }
}
